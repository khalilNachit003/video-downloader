{
  "name": "video-downloader",
  "version": "1.0.0",
  "description": "Website to download videos from YouTube, Facebook, Instagram and other social platforms.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/install-bins.js",
