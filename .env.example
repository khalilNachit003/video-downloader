# ── Brand ───────────────────────────────────────────────────────────
# Change these to rebrand the site (they appear in the header + meta).
BRAND_NAME=Video Downloader
BRAND_TAGLINE=Download videos from YouTube, Facebook & Instagram

# ── Server ──────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ── Limits ──────────────────────────────────────────────────────────
# Metadata / playlist requests per IP per minute.
RATE_LIMIT_MAX=30
# Actual media downloads per IP per minute.
RATE_LIMIT_DOWNLOAD_MAX=10
# How many yt-dlp processes may run at the same time.
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MS=300000
# Highest video height offered in the quality list.
MAX_VIDEO_HEIGHT=2160

# ── Optional: cookies for Instagram / Facebook ─────────────────────
# Absolute path to a Netscape-format cookies.txt file.
# COOKIES_FILE=/app/cookies.txt

# ── Optional: YouTube player client (use "default" to disable) ─────
# tv_embedded returns real HTTPS DASH URLs; YouTube often throttles its
# streaming mechanism (SABR) to a trickle for modern / music videos.
# YOUTUBE_PLAYER_CLIENT=tv_embedded,default

# ── Optional: custom binary locations ──────────────────────────────
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFMPEG_LOCATION=/usr/bin

# ── Optional: allow other origins to call the API ──────────────────
# CORS_ORIGINS=https://example.com,https://www.example.com
